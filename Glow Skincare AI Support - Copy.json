    {
      "parameters": {
        "jsCode": "const clean = (text) => {\n  if (typeof text !== 'string') return text;\n  let t = text;\n  t = t.split('\\\\r\\\\n').join('\\n');\n  t = t.split('\\\\n').join('\\n');\n  t = t.split('\\\\t').join(' ');\n  t = t.replace(/\\*+/g, '');\n  t = t.replace(/^\\s*#{1,6}\\s*/gm, '');\n  t = t.replace(/^\\s*>\\s?/gm, '');\n  t = t.replace(/\\n{3,}/g, '\\n\\n');\n  return t.trim();\n};\nfor (const item of $input.all()) {\n  const out = (item.json && item.json.output) ? item.json.output : {};\n  item.json.output = Object.assign({}, out, { draft_reply: clean(out.draft_reply) });\n}\nreturn $input.all();\n"
      },
